# Image used by GoReleaser: the prebuilt static binary plus git (for
# repository URLs and history) on a minimal base.
FROM alpine:3.22
RUN apk add --no-cache git ca-certificates && adduser -D -u 10001 capybari
COPY capybari /usr/local/bin/capybari
USER capybari
WORKDIR /src
ENTRYPOINT ["capybari"]
CMD ["--help"]
